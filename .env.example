# Mosquitto
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=home/bus
MQTT_CLIENT_ID=hctb-mqtt
MQTT_DISCOVERY_ENABLED=true
MQTT_DISCOVERY_PREFIX=homeassistant

# Here Comes The Bus (Synovia SOAP)
HCTB_SCHOOL_CODE=
HCTB_USERNAME=
HCTB_PASSWORD=

# Polling (seconds)
HCTB_POLL_INTERVAL_SECONDS=90
HCTB_IDLE_POLL_INTERVAL_SECONDS=900

# Local timezone + active windows (HH:MM)
HCTB_TIMEZONE=America/New_York
HCTB_MORNING_START=06:00
HCTB_MORNING_END=09:00
HCTB_AFTERNOON_START=14:00
HCTB_AFTERNOON_END=18:00

# Optional distance-to-home (omit to skip; use your own coordinates)
# HCTB_HOME_LAT=40.00
# HCTB_HOME_LON=-75.00

# Optional student allowlist (IDs or first-name slugs; empty = all)
# HCTB_STUDENT_IDS=

LOG_LEVEL=INFO
